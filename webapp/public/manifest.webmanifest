{
  "name": "EventHub",
  "short_name": "EventHub",
  "description": "Book weddings, funerals, corporate and social events across Ghana.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#FAFAFA",
  "theme_color": "#2B5FFF",
  "categories": ["lifestyle", "entertainment", "social"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    { "name": "Explore events", "short_name": "Explore", "url": "./explore" },
    { "name": "My bookings", "short_name": "Bookings", "url": "./bookings" },
    { "name": "Notifications", "short_name": "Alerts", "url": "./notifications" }
  ]
}
